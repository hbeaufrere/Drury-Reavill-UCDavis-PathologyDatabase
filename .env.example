# Neon Postgres connection string.
# Use the POOLED connection string for the running app on Vercel;
# use the DIRECT (non-pooled) connection string when running `npm run db:seed`.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Password that unlocks patient names (admin mode) at /admin.
# If unset, admin mode is disabled and all visitors see anonymized data.
ADMIN_PASSWORD=
